# Server Port
PORT=4000

# Database
# If DATABASE_URL is commented out or omitted in development,
# the backend uses in-memory 'pg-mem' database with seeded records.
# For real PostgreSQL, uncomment and configure:
# DATABASE_URL=postgres://brightloop:password@localhost:5432/brightloop

# Initial Admin Credentials (used on first empty PostgreSQL database startup)
ADMIN_EMAIL=admin@brightloop.local
ADMIN_PASSWORD=Brightloop!2026

# JWT Authentication Secret
JWT_SECRET=development-only-brightloop-secret-2026

# Application URLs & CORS
APP_URL=http://localhost:3000

# Redis Queue & BullMQ (Optional in dev, required for scheduled hourly billing worker)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Email / SMTP (Optional in dev, required for sending invoice emails & reset links)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=hello@brightloop.local
