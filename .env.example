# NextAuth
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
NEXTAUTH_URL=http://localhost:3000

# Backend API URL (the separate Brightloop backend server)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend Service
BACKEND_URL=http://localhost:4000
BACKEND_API_KEY=your-backend-api-key-here

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/brightloop

# JWT
JWT_SECRET=your-secret-key-here-min-32-chars
JWT_EXPIRES_IN=1h

# Server
PORT=4000
NODE_ENV=development

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis (for background jobs)
REDIS_URL=redis://localhost:6379

# File upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760 # 10MB

# Logging
LOG_LEVEL=debug

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000

