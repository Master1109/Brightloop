{
  "name": "brightloop-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Brightloop REST API for authentication, subscriptions, and billing.",
  "main": "server/main.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env server/main.ts",
    "start": "tsx server/main.ts",
    "test": "tsx --env-file=.env --test server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --env-file=.env scripts/integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^3.0.0",
    "bullmq": "^5.40.0",
    "dotenv": "^18.0.9",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.0",
    "pdfkit": "^0.17.0",
    "pg": "^8.13.0",
    "pg-mem": "^3.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
