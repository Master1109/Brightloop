{
  "name": "brightloop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "backend:start": "node dist/main.js",
    "backend:dev": "nest start --watch",
    "backend:build": "nest build",
    "backend:test": "jest --passWithNoTests",
    "backend:seed": "ts-node -P src/tsconfig.json -r tsconfig-paths/register src/scripts/seed.ts",
    "backend:setup": "npm run backend:migration:run",
    "backend:migration:run": "ts-node -P src/tsconfig.json ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "backend:typecheck": "tsc --noEmit -p src/tsconfig.json",
    "typecheck": "npm run backend:typecheck && npm run frontend:typecheck",
    "build": "npm run backend:build && npm run frontend:build",
    "frontend:dev": "next dev -p 3000",
    "frontend:build": "next build",
    "frontend:start": "next start -p 3000",
    "frontend:typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-auth": "^4.24.11",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "reflect-metadata": "^0.1.13",
    "tailwind-merge": "^2.6.0",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.0",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.0",
    "autoprefixer": "^10.4.20",
    "jest": "^29.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
